flowchart LR
    subgraph client ["Operator Surface"]
        browser["SignalRoom control room<br/>start · inspect · kill · approve"]
    end

    subgraph gateway ["Local Interface"]
        http["SignalRoom HTTP API<br/>Temporal client + provider evidence reader"]
    end

    subgraph async ["Durable Control Plane"]
        temporal["Temporal Server<br/>Event History · task queue · retries · timers · Signals"]
    end

    subgraph service ["Agent Execution Plane"]
        supervisor["Worker supervisor"]
        worker["Temporal Worker<br/>Workflow replay + Activity execution"]
        agents["Six bounded agents<br/>five child Workflows + policy-bound side-effect Activities"]
        tools["Typed tools<br/>path guards · tests · Git · provider policy"]
    end

    subgraph datastore ["Evidence and Artifacts"]
        sqlite["SignalRoom SQLite<br/>operator projection + case timeline"]
        gitlab["Per-case Git lab<br/>source · tests · branch · reviewed commit · merge"]
    end

    subgraph model ["Local Model Runtime"]
        ollama["Ollama<br/>diagnosis · tool selection · replacement source"]
    end

    subgraph provider ["Demo External Boundary"]
        paymentapi["Local third-party payment API<br/>idempotent POST · unsafe POST · safe GET"]
        paymentdb["Provider-owned SQLite<br/>payments · key receipts · request audit"]
    end

    browser -->|"HTTP actions and polling"| http
    http -.->|"gRPC: start Workflow + approval Signal"| temporal
    temporal -.->|"schedule or replay unresolved tasks"| worker
    supervisor -->|"spawn replacement process"| worker
    worker -->|"run child Workflows"| agents
    agents -->|"validated commands"| tools
    agents -.->|"structured local model turns"| ollama
    tools -->|"guarded patch · test · commit · merge"| gitlab
    tools -->|"stable-key POST, one-shot POST, or safe GET"| paymentapi
    worker -->|"project stages, agents, context, and evidence"| sqlite
    http -->|"read case projection"| sqlite
    http -->|"read provider proof"| paymentapi
    paymentapi -->|"own transaction boundary"| paymentdb

    temporal -. "recorded history survives Worker death" .-> worker
